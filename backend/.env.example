# BigQuery authentication is environment-managed.
# In Vertex AI / Workbench, leave credential and project values unset.
# The backend uses the active Application Default Credentials and project.
# GOOGLE_APPLICATION_CREDENTIALS=
# Standard VOIS Vertex/BigQuery context (already applied by the engine defaults):
BIGQUERY_PROJECT=vf-gr-mc2-nonlive
BIGQUERY_SOURCE_PROJECT=vf-gr-mc2-nonlive
BIGQUERY_TARGET_PROJECT=vf-gr-mc2-nonlive
BIGQUERY_SOURCE_DATASET=vfgr_mc2_nonlive_gr_lake_mc2_processed_s
BIGQUERY_TARGET_DATASET=vfgr_mc2_nonlive_gr_lake_mc2_presentation_processed_s
# GOOGLE_CLOUD_PROJECT is still discovered from Vertex ADC when available.

ENV=local
DEMO_LOGIN_ENABLED=true
READ_ONLY_SQL_ENABLED=true
TRANSFORMSQL_DRY_RUN_ENABLED=true
TRANSFORMSQL_COST_DISPLAY_ENABLED=true
TRANSFORMSQL_PII_MASKING_ENABLED=false
TRANSFORMSQL_VERTEX_SUGGESTIONS_ENABLED=false
TRANSFORMSQL_AUDIT_LOG_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:8080
BIGQUERY_LOCATION=US
BIGQUERY_MAX_ROWS=500
BIGQUERY_MAX_BYTES_BILLED=1000000000
GCS_RESULTS_BUCKET=narasimha-test-bucket
GCS_RESULTS_PREFIX=vois-transformsql
